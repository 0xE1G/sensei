<?xml version="1.0"?>
<!-- Example imported object (URDF): a soap bottle, a body with a narrower pump cap on top. One link. -->
<robot name="soap_bottle">
  <link name="soap_bottle">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="0.12"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <collision name="body">
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.05 0.035 0.10"/></geometry>
    </collision>
    <collision name="cap">
      <origin xyz="0 0 0.115"/>
      <geometry><cylinder radius="0.012" length="0.03"/></geometry>
    </collision>
  </link>
</robot>
